menu "Backend Pairing Configuration"

    config BACKEND_PAIRING_URL
        string "Backend Pairing WebSocket URL"
        default "wss://iot.xingnian.vip/ws/device/pair"
        help
            后台配对服务器的WebSocket地址
            格式：wss://host/ws/device/pair
            例如：wss://ai-server.example.com/ws/device/pair

    config BACKEND_PAIRING_TIMEOUT_MS
        int "Pairing Timeout (ms)"
        default 300000
        range 30000 600000
        help
            配对超时时间（毫秒）
            默认：300000 (5分钟)

endmenu
